; Configuration for the folder service:
;   python -m medwatch_ocr.cli service --config medwatch-service.ini
; One ZIP in [folders] inbound is one case - the FDA form PDF inside it becomes
; the message and every other file in it is embedded as an attachment.  The XML
; is written to outbound, and the ZIP is moved to processed, or to error with an
; e-mail when the case cannot be converted.

[folders]
; Linux; on Windows use local paths instead, e.g. C:\medwatch\inbound
inbound = /srv/medwatch/inbound
outbound = /srv/medwatch/outbound
processed = /srv/medwatch/processed
error = /srv/medwatch/error

[conversion]
; e2b-r2 | e2b-r2-fda | mdr | emdr-hl7 | gl42 | pvx1932a | vich-hl7
; One format for every case in the inbound folder.  "auto" (or empty) instead
; reads each form and writes the format named below for the center it belongs to
; - use it when the folder holds more than one kind of case, since a veterinary
; report cannot become emdr-hl7 nor a device report vich-hl7.
format = auto
; Used when format is auto; each may be left empty for that center's default.
format_cder = e2b-r2-fda
format_cdrh = emdr-hl7
format_cvm = vich-hl7
; Optional overrides, normally left empty: CDER | CDRH | CVM, premarket | postmarket.
center =
stage =
; auto | official | 1932 | 1932a | flat | labelled
layout = auto
; text-layer (default, exact and instant on fillable PDFs) | auto | paddleocr
; Scanned, image-only forms are detected and read with PaddleOCR either way.
engine = text-layer
dpi = 200
lang = en

[service]
; How often the inbound folder is swept, in seconds.
poll_seconds = 30
; A ZIP is taken only once its size has been unchanged for this long, so a file
; still being copied in is left alone.
settle_seconds = 5

[email]
; The note sent when a case is moved to the error folder, with the case ZIP
; itself attached.  Nothing is sent while recipients is empty.
;
; How the note leaves this machine:
;   smtp    - a mail server; needs host, sender and recipients below
;   outlook - the Outlook this Windows account is already signed in to; needs
;             only recipients, and no relay, so it works where SMTP is blocked
;             (requires pywin32: pip install pywin32)
;   eml     - write the note as a .eml file in drop_dir for something else to
;             send; also the way to see exactly what would have been mailed
transport = smtp
drop_dir =
; Only for transport = smtp.  Leave host empty to log the failure and mail no one.
; e.g. host = smtp.yourcompany.com
host =
; 25 for a plain relay, 587 with use_tls
port = 25
; true for a server that wants STARTTLS (port 587 as a rule)
use_tls = false
sender = medwatch-ocr@yourcompany.com
; one or more, separated by commas or semicolons
recipients = safety-ops@yourcompany.com, oncall@yourcompany.com
; only for a server that asks to authenticate
username =
password =
subject_prefix = [medwatch-ocr]
; Send the ZIP that failed with the note, so the reader has the input to hand.
attach_zip = true
; A ZIP larger than this is named in the note but not attached, since mail
; servers refuse large messages.
max_attachment_mb = 10
