; Configuration for the folder service (and its e-mail intake, [intake] below):
;   python -m cvm_aer                    (reads cvm-aer-service.ini from the current folder;
;                                        use --config <path> for another file, --once for one sweep)
; One ZIP in [folders] inbound is one case - the Form FDA 1932 / 1932a PDF inside
; it becomes CVM's VICH HL7 message (vich-hl7) and every other file in it is a supporting
; document, embedded.  The message is validated against FDA's VICH schemas, written to
; outbound, and the ZIP is moved to processed - or to error with an e-mail when the
; case cannot be converted or its message does not validate.

[folders]
; Linux; on Windows use local paths instead, e.g. C:\cvm-aer\inbound
inbound = /srv/cvm-aer/inbound
outbound = /srv/cvm-aer/outbound
processed = /srv/cvm-aer/processed
error = /srv/cvm-aer/error

[conversion]
; vich-hl7 is the only output: CVM's HL7 v3 submission message (VICH GL42 data in
; MCCI_IN200100UV01) with the form and every attachment embedded, schema-validated.
; gl42 is accepted only to test the error path: nothing is converted, every ZIP goes
; to the error folder and the e-mail note is sent.  (Also: --format gl42 on the command line.)
format = vich-hl7
; auto | 1932 (static form) | 1932a (dynamic XFA form)
layout = auto
; text-layer (default, exact and instant on fillable PDFs) | auto | paddleocr
; Scanned, image-only forms are detected and read with PaddleOCR either way.
engine = text-layer
dpi = 200
lang = en

[service]
; How often the inbound folder is swept, in seconds.
poll_seconds = 30
; A ZIP is taken only once its size has been unchanged for this long, so a file
; still being copied in is left alone.
settle_seconds = 5

[intake]
; Case e-mails.  One e-mail is one case: a single ZIP attachment is put in [folders]
; inbound as it is; otherwise all the attachments (form + supporting documents) are
; zipped into one ZIP.  The e-mail is then moved to processed_folder - or, when it has
; nothing to take (no attachments, two ZIPs, a broken ZIP), to rejected_folder with the
; [email] note.  Every e-mail taken is written to the ledger, so none is taken twice.
; The service reads the mailbox on every sweep; "python -m cvm_aer intake" reads it once.
;
; Where the e-mails are read from - leave empty to switch e-mail intake off:
;   outlook - the Outlook signed in on this PC (Windows; pip install pywin32)
;   imap    - a mail server over IMAP: host, username, password below
;   folder  - .eml files saved in eml_dir (for testing without a mailbox)
source =
; outlook only: the mailbox as Outlook lists it (e.g. a shared mailbox); empty = your own
mailbox =
; The folder that is watched, e.g. Inbox or Inbox/CVM-AER
folder = Inbox
; Only e-mails whose subject contains this (any case, e.g. "Fwd: cvm-aer N141562")
; are read; every other e-mail is left where it is, untouched.  Several words may be
; given, comma-separated.  Left empty it is still CVM-AER; * reads every e-mail.
subject_contains = CVM-AER
; Where handled e-mails go: subfolders of the watched folder (outlook, folder),
; top-level folders on the server (imap).  Created if missing.
processed_folder = CVM-AER Processed
rejected_folder = CVM-AER Rejected
; imap only
host =
port = 993
use_ssl = true
username =
password =
; folder only
eml_dir =
; empty = cvm-aer-intake-ledger.txt next to the inbound folder
ledger =
; Attachments left out of the case: the signature / logo images Outlook adds.
ignore = image0*.png, image0*.jpg, image0*.jpeg, image0*.gif

[email]
; The note sent when a case is moved to the error folder, with the case ZIP
; itself attached.  Nothing is sent while recipients is empty.
;
; How the note leaves this machine:
;   smtp    - a mail server; needs host, sender and recipients below
;   outlook - the Outlook this Windows account is already signed in to; needs
;             only recipients, and no relay, so it works where SMTP is blocked
;             (requires pywin32: pip install pywin32)
;   eml     - write the note as a .eml file in drop_dir for something else to
;             send; also the way to see exactly what would have been mailed
transport = smtp
drop_dir =
; Only for transport = smtp.  Leave host empty to log the failure and mail no one.
; e.g. host = smtp.yourcompany.com
host =
; 25 for a plain relay, 587 with use_tls
port = 25
; true for a server that wants STARTTLS (port 587 as a rule)
use_tls = false
sender = Anurag.Saxena@fda.hhs.gov
; one or more, separated by commas or semicolons
recipients = Anurag.Saxena@fda.hhs.gov
; only for a server that asks to authenticate
username =
password =
subject_prefix = [cvm-aer]
; Send the ZIP that failed with the note, so the reader has the input to hand.
attach_zip = true
; A ZIP larger than this is named in the note but not attached, since mail
; servers refuse large messages.
max_attachment_mb = 10
